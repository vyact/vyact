{
  "name": "vyact",
  "version": "1.3.2",
  "description": "Local AI Agent - Voyage & Act",
  "main": "main.js",
  "author": {
    "name": "Vyact",
    "email": "vyactagent@gmail.com"
  },
  "homepage": "https://github.com/vyact/vyact",
  "scripts": {
    "start": "electron .",
    "start:dev": "VYACT_RENDERER_URL=http://localhost:5173 electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage deb --x64"
  },
  "build": {
    "appId": "com.vyact.app",
    "productName": "Vyact",
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Vyact",
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "linux": {
      "category": "Utility",
      "icon": "vyact-icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "files": [
      "main.js",
      "platform.js",
      "preload.js",
      "loading.html",
      "error.html",
      "vyact-icon.png",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "python-runtime/python",
        "to": "python"
      },
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!tests/**"
        ]
      },
      {
        "from": "../frontend/src/i18n/locales",
        "to": "locales"
      }
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
