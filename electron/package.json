{
  "name": "vyact",
  "version": "1.0.1",
  "description": "Local AI Agent - Voyage & Act",
  "main": "main.js",
  "author": "Alex",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.vyact.app",
    "productName": "Vyact",
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Vyact",
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "error.html",
      "vyact-icon.png",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app"
      },
      {
        "from": "../frontend/src/i18n/locales",
        "to": "locales"
      }
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
