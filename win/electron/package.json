{
  "name": "vyact",
  "version": "1.2.13",
  "description": "Local AI Agent - Voyage & Act",
  "main": "main.js",
  "author": "Alex",
  "scripts": {
    "start": "electron .",
    "start:dev": "set VYACT_RENDERER_URL=http://localhost:5173&& electron .",
    "build": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.vyact.app",
    "productName": "Vyact",
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vyact"
    },
    "files": [
      "main.js",
      "platform.js",
      "preload.js",
      "loading.html",
      "error.html",
      "vyact-icon.png",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "python-runtime/python",
        "to": "python"
      },
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!tests/**"
        ]
      },
      {
        "from": "../frontend/src/i18n/locales",
        "to": "locales"
      }
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
